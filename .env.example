# ---------------------------------------------------------------------------
# CRMWSP — variables de entorno de ejemplo (desarrollo local).
# Copia este archivo a `.env` y ajusta valores. `.env` NUNCA se commitea.
# Los valores de ejemplo apuntan a infra/docker-compose.dev.yml (localhost).
# Las claves de terceros (Gupshup, OpenAI, Stripe) se dejan vacías: ponlas
# solo en tu `.env` local o en el gestor de secretos del entorno.
# ---------------------------------------------------------------------------

# --- Runtime ---------------------------------------------------------------
# development | test | production
NODE_ENV=development
# Puerto HTTP de apps/api (NestJS/Fastify).
API_PORT=4000
# URL pública de la API que consume apps/web (expuesta al navegador).
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- PostgreSQL ------------------------------------------------------------
# Rol de APLICACIÓN: sin SUPERUSER ni BYPASSRLS; sujeto a Row Level Security.
# Lo usan api y worker en runtime a través de withTenant(). Ver docs/adr/0002.
# El servicio `postgres-init` del compose crea este rol (crmwsp_app).
DATABASE_URL=postgresql://crmwsp_app:crmwsp_app@localhost:5432/crmwsp
# Rol de MIGRACIONES: con permisos de DDL (crear tablas, políticas RLS,
# extensiones). Solo lo usan `pnpm db:migrate` y CI. Nunca en runtime.
DATABASE_URL_MIGRATOR=postgresql://crmwsp:crmwsp@localhost:5432/crmwsp

# --- Redis (BullMQ, rate limiting, locks de conversación) -------------------
REDIS_URL=redis://localhost:6379

# --- Almacenamiento S3-compatible (RustFS en dev; R2/S3 en prod) ------------
# Ver docs/adr/0005-s3-local-sin-minio.md. Consola dev: http://localhost:9001
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
# Bucket por entorno; el prefijo por tenant lo gestiona la aplicación.
S3_BUCKET=crmwsp-dev
# Credenciales SOLO de desarrollo (las del servicio `s3` del compose).
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
# true en dev (RustFS solo sirve path-style); false con AWS S3 / R2.
S3_FORCE_PATH_STYLE=true

# --- SMTP (Mailpit en dev: UI en http://localhost:8025) ---------------------
SMTP_HOST=localhost
SMTP_PORT=1025

# --- OpenAI (único proveedor de IA, detrás de LLMProvider) ------------------
# Opcional: clave de la plataforma para tenants con créditos del SaaS.
# Los tenants pueden traer su propia clave (BYOK), que se guarda cifrada.
OPENAI_API_KEY=

# --- Gupshup (BSP de WhatsApp, detrás de WhatsAppProvider) ------------------
# Nombre de la app en Gupshup.
GUPSHUP_APP_NAME=
# API key de la cuenta Gupshup (dev/staging). En prod va cifrada por tenant.
GUPSHUP_API_KEY=
# Secreto para verificar la firma HMAC de los webhooks entrantes.
GUPSHUP_WEBHOOK_SECRET=

# --- Stripe (Billing del SaaS y cobros del cliente final) -------------------
# Usa claves de TEST (sk_test_...) fuera de producción.
STRIPE_SECRET_KEY=
# Secreto de firma del endpoint de webhooks (whsec_...).
STRIPE_WEBHOOK_SECRET=

# --- Seguridad --------------------------------------------------------------
# Clave maestra para envelope encryption de secretos por tenant
# (API keys del BSP, claves OpenAI BYOK). 32 bytes en base64.
# Generar: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=
# Secreto para firmar sesiones/tokens de autenticación (Auth.js).
# Generar: openssl rand -base64 32
AUTH_SECRET=
