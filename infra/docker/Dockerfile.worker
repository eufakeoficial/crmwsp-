# syntax=docker/dockerfile:1
# Build from the repo root: docker build -f infra/docker/Dockerfile.worker -t crmwsp-worker .
FROM node:22-slim AS build
ENV PNPM_HOME=/pnpm PATH=/pnpm:$PATH
RUN corepack enable
WORKDIR /repo
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @crmwsp/worker build
# Production dependencies of this app only (workspace packages are bundled into dist).
RUN pnpm --filter @crmwsp/worker --prod deploy --legacy /out

FROM node:22-slim
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /out/node_modules ./node_modules
COPY --from=build /repo/apps/worker/dist ./dist
COPY --from=build /repo/apps/worker/package.json ./package.json
USER node
CMD ["node", "dist/index.js"]
